---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
import { facials, skinBoosters, nails, categoryLabels } from '../data/services';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const groups = [
  { label: categoryLabels.facials, items: facials },
  { label: categoryLabels['skin-boosters'], items: skinBoosters },
  { label: categoryLabels.nails, items: nails },
];
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__info">
      <SectionHeading
        id="contact-title"
        as={headingLevel}
        size={headingLevel === 'h1' ? 'h1' : 'h2'}
        eyebrow="Get in touch"
        title="Questions? <em>Let’s talk skin.</em>"
        lead="Send a message and Chlo will get back to you — or book straight in on Booksy."
      />

      <ul class="contact__cards" role="list" data-reveal-stagger>
        <li>
          <a href={site.phoneHref} class="contact-card">
            <span class="contact-card__icon"><Icon name="phone" /></span>
            <span><small>Call or text</small>{site.phone}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="contact-card">
            <span class="contact-card__icon"><Icon name="mail" /></span>
            <span><small>Email</small>{site.email}</span>
          </a>
        </li>
        <li>
          <div class="contact-card">
            <span class="contact-card__icon"><Icon name="pin" /></span>
            <span><small>Covering</small>{site.area}</span>
          </div>
        </li>
        <li>
          <div class="contact-card">
            <span class="contact-card__icon"><Icon name="car" /></span>
            <span><small>Mobile service</small>Comes to you for +£{site.mobileSurcharge}</span>
          </div>
        </li>
      </ul>

      <div class="contact__map" data-reveal>
        <iframe
          src={site.mapEmbed}
          title="Map showing the North Wales area covered by Glow With Chlo"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>

    <form
      class="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      data-contact-form
      data-astro-reload
      data-reveal
    >
      <input type="hidden" name="access_key" value={site.web3formsKey} />
      <input type="hidden" name="subject" value="New enquiry from glow-with-chlo.com" />
      <input type="hidden" name="from_name" value="Glow With Chlo website" />
      <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="field">
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="80" />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="120" />
        </div>
        <div class="field">
          <label for="cf-phone">Phone <span class="optional">(optional)</span></label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
        </div>
      </div>
      <div class="field">
        <label for="cf-treatment">Interested in</label>
        <select id="cf-treatment" name="treatment">
          <option value="">Not sure yet — I’d love advice</option>
          {
            groups.map((g) => (
              <optgroup label={g.label}>
                {g.items.map((s) => (
                  <option value={s.name}>{s.name}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </div>
      <div class="field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" rows="5" required maxlength="2000"></textarea>
      </div>
      <button type="submit" class="btn contact-form__submit" data-magnetic>
        <span data-submit-label>Send message</span>
        <Icon name="send" class="btn__icon" size={16} />
      </button>
      <p class="contact-form__status" role="status" aria-live="polite" data-form-status></p>
    </form>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .contact__info {
    display: grid;
    gap: 2.5rem;
  }
  .contact__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    padding: 0;
    margin: 0;
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--paper);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--step--1);
    overflow-wrap: anywhere;
    transition:
      border-color 0.4s,
      transform 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }
  a.contact-card:hover {
    border-color: var(--rose-gold);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .contact-card small {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rose-gold-text);
  }
  .contact-card__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--blush);
    color: var(--rose-gold-text);
  }
  .contact__map {
    overflow: hidden;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    aspect-ratio: 16 / 10;
    background: var(--blush);
  }
  .contact__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.6) sepia(0.25) saturate(0.9);
  }

  .contact-form {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    border-radius: var(--r-lg);
    background: var(--paper);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--line);
  }
  .field {
    display: grid;
    gap: 0.45rem;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .field label {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .optional {
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: none;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--cream);
    font-size: var(--step-0);
    transition:
      border-color 0.3s,
      box-shadow 0.3s,
      background 0.3s;
  }
  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--rose-gold-text);
    background: var(--paper);
    box-shadow: 0 0 0 4px rgb(185 128 106 / 0.18);
  }
  .field input:user-invalid,
  .field textarea:user-invalid {
    border-color: #b3261e;
  }
  .contact-form__submit {
    justify-self: start;
  }
  .contact-form__status {
    min-height: 1.5em;
    font-weight: 600;
    font-size: var(--step--1);
  }
  .contact-form__status[data-state='ok'] {
    color: #2f6b3f;
  }
  .contact-form__status[data-state='error'] {
    color: #b3261e;
  }

  @media (max-width: 960px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .contact-form {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .contact__cards,
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
