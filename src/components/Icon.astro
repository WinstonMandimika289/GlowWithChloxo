---
// Minimal line-icon set (24px grid, 1.6 stroke) — inherits currentColor.
export type IconName =
  | 'arrow'
  | 'arrow-right'
  | 'phone'
  | 'mail'
  | 'instagram'
  | 'facebook'
  | 'tiktok'
  | 'sparkle'
  | 'star'
  | 'plus'
  | 'close'
  | 'menu'
  | 'chat'
  | 'send'
  | 'pin'
  | 'check'
  | 'clock'
  | 'play'
  | 'car'
  | 'shield';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  label?: string;
}
const { name, size = 20, class: className, label } = Astro.props;

const filled = new Set(['star', 'play', 'tiktok']);
const paths: Record<IconName, string> = {
  arrow: '<path d="M7 17 17 7M9 7h8v8"/>',
  'arrow-right': '<path d="M4 12h16M14 6l6 6-6 6"/>',
  phone:
    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 7 9 6 9-6"/>',
  instagram:
    '<rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/>',
  facebook: '<path d="M17.5 2.5h-3a5 5 0 0 0-5 5v3h-3v4h3v7h4v-7h3l1-4h-4v-3a1 1 0 0 1 1-1h3z"/>',
  tiktok:
    '<path d="M16.2 2.5c.4 2.5 2 4.1 4.3 4.4v3.3a8 8 0 0 1-4.3-1.3v6.6a6 6 0 1 1-6-6h.6v3.4h-.6a2.6 2.6 0 1 0 2.6 2.6V2.5z"/>',
  sparkle: '<path d="M12 3.5 13.9 9l5.6 1.9-5.6 1.9L12 18.5l-1.9-5.7L4.5 11l5.6-1.9z"/><path d="M19 3v3M17.5 4.5h3"/>',
  star: '<path d="m12 2.8 2.8 5.8 6.4.9-4.6 4.5 1.1 6.3L12 17.3l-5.7 3 1.1-6.3-4.6-4.5 6.4-.9z"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  menu: '<path d="M4 8h16M4 16h11"/>',
  chat: '<path d="M20.5 12a8.5 8.5 0 0 1-12.3 7.6L3.5 21l1.4-4.6A8.5 8.5 0 1 1 20.5 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01" stroke-width="2.4"/>',
  send: '<path d="M21 3 10.5 13.5M21 3l-6.5 18-4-7.5L3 9.5z"/>',
  pin: '<path d="M12 21s-7-6.1-7-11.4a7 7 0 1 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.6" r="2.5"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/>',
  play: '<path d="M8 5.3v13.4L19 12z"/>',
  car: '<path d="M5 16.5h14M6.5 16.5V19M17.5 16.5V19M4 16.5v-4l2-5.2A2 2 0 0 1 7.9 6h8.2a2 2 0 0 1 1.9 1.3l2 5.2v4"/><path d="M4 12.5h16"/><circle cx="7.5" cy="14.5" r=".6" fill="currentColor"/><circle cx="16.5" cy="14.5" r=".6" fill="currentColor"/>',
  shield: '<path d="M12 21.5s7.5-3.2 7.5-9.5V5.2L12 2.5 4.5 5.2V12c0 6.3 7.5 9.5 7.5 9.5z"/><path d="m8.8 12 2.2 2.2 4.3-4.4"/>',
};
const isFilled = filled.has(name);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={paths[name]}
/>
