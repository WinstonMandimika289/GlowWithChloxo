---
// Fine-line botanical sprig echoing the logo's illustration. Decorative only.
interface Props {
  class?: string;
  flip?: boolean;
}
const { class: className, flip = false } = Astro.props;
---

<svg
  class:list={['sprig', className, { 'sprig--flip': flip }]}
  viewBox="0 0 120 220"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  <path class="sprig__stem" d="M60 214C58 170 62 128 72 92 80 64 88 38 104 8" />
  <g class="sprig__leaves">
    <path d="M61 186c-12-4-20-12-22-24 12 3 20 11 22 24z" />
    <path d="M62 170c10-6 20-8 30-4-8 8-18 9-30 4z" />
    <path d="M63 148c-13-2-22-9-26-21 13 1 22 9 26 21z" />
    <path d="M66 132c9-8 19-11 30-9-7 9-17 12-30 9z" />
    <path d="M69 111c-12-4-20-12-22-24 12 3 20 11 22 24z" />
    <path d="M74 94c8-9 17-13 28-12-6 10-16 14-28 12z" />
    <path d="M79 73c-11-5-17-14-18-25 11 4 17 13 18 25z" />
    <path d="M86 56c7-9 15-13 25-13-5 10-14 14-25 13z" />
    <path d="M92 38c-9-5-14-13-14-23 9 4 14 12 14 23z" />
    <circle cx="104" cy="9" r="2.4" />
    <circle cx="97" cy="22" r="1.6" />
  </g>
</svg>

<style>
  .sprig {
    width: 100%;
    height: auto;
    color: var(--rose-gold);
    opacity: 0.85;
  }
  .sprig--flip {
    transform: scaleX(-1);
  }
</style>
