---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { img } from '../lib/images';
import { site, faqs } from '../data/site';
import { skinBoosters, getService, formatPrice, serviceHref } from '../data/services';

const profhilo = getService('profhilo')!;
const others = skinBoosters.filter((s) => s.slug !== 'profhilo');
const boosterFaqs = faqs.filter((f) => /Profhilo|downtime|sessions|first appointment/i.test(f.q));
---

<Layout
  title="Skin Boosters & Profhilo"
  description={`Profhilo (${formatPrice(profhilo.price)}), skin boosters and Aqua-Exosome treatments in North Wales & Liverpool — deep hydration, firmer skin and a natural glow. Consultation-led.`}
  image="photos/mesotherapy-procedure.jpg"
>
  <PageHero
    eyebrow="Skin boosters"
    title="Hydration that <em>glows</em> from within"
    lead="Injectable skin boosters — including Profhilo — for deep hydration, firmer skin and natural, lit-from-within radiance."
    image="photos/mesotherapy-procedure.jpg"
    imageAlt="Skin booster serum being delivered to the skin"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Skin Boosters' }]}
  >
    <Fragment slot="actions">
      <a class="btn" href={site.booking} target="_blank" rel="noopener" data-magnetic>
        Book a consultation <Icon name="arrow" class="btn__icon" size={16} />
      </a>
      <button type="button" class="btn btn--ghost" data-chat-open data-chat-ask="Tell me about Profhilo">
        <Icon name="chat" size={18} /> Ask about Profhilo
      </button>
    </Fragment>
  </PageHero>

  <!-- Profhilo feature -->
  <section class="section section--blush profhilo" aria-labelledby="profhilo-title">
    <div class="container profhilo__grid">
      <div class="profhilo__media" data-clip>
        <Picture
          src={img(profhilo.image!)}
          alt={profhilo.imageAlt ?? ''}
          formats={['avif', 'webp']}
          widths={[420, 720, 960]}
          sizes="(max-width: 900px) 90vw, 44vw"
        />
      </div>
      <div class="profhilo__body">
        <SectionHeading
          id="profhilo-title"
          eyebrow={profhilo.tagline}
          title="Profhilo"
          lead={profhilo.intro?.[0]}
        />
        <div class="profhilo__meta" data-reveal>
          <span class="price profhilo__price">{formatPrice(profhilo.price)}</span>
          {profhilo.duration && <span class="chip"><Icon name="clock" size={14} /> {profhilo.duration}</span>}
        </div>
        <ul class="profhilo__highlights" role="list" data-reveal-stagger>
          {
            profhilo.highlights?.map((h) => (
              <li>
                <Icon name="sparkle" size={16} /> {h}
              </li>
            ))
          }
        </ul>
        <div class="profhilo__actions" data-reveal>
          <a class="btn" href={serviceHref(profhilo)}>How Profhilo works <Icon name="arrow" class="btn__icon" size={16} /></a>
          <a class="link-arrow" href={site.booking} target="_blank" rel="noopener">Book on Booksy <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Other boosters -->
  <section class="section" aria-labelledby="boosters-title">
    <div class="container">
      <SectionHeading
        id="boosters-title"
        eyebrow="More boosters"
        title="Skin boosters &amp; <em>exosomes</em>"
        lead="Tailored to your skin at consultation — ask Chlo which option is right for you."
      />
      <ul class="booster-list" role="list" data-reveal-stagger>
        {
          others.map((s) => (
            <li class="booster">
              <div class="booster__media">
                {s.image ? (
                  <Picture src={img(s.image)} alt={s.imageAlt ?? ''} formats={['avif', 'webp']} widths={[240, 400]} sizes="160px" />
                ) : (
                  <Icon name="sparkle" size={40} />
                )}
              </div>
              <div class="booster__body">
                <h3 class="h3">{s.name}</h3>
                <p class="muted">{s.summary}</p>
                {s.duration && (
                  <span class="booster__time">
                    <Icon name="clock" size={14} /> {s.duration}
                  </span>
                )}
              </div>
              <div class="booster__aside">
                <span class="price booster__price">{formatPrice(s.price)}</span>
                <a class="btn btn--sm btn--ghost" href={site.booking} target="_blank" rel="noopener">
                  Book
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Consultation + FAQ -->
  <section class="section section--deep" aria-labelledby="consult-title">
    <div class="container consult__grid">
      <div class="consult__head">
        <SectionHeading
          id="consult-title"
          eyebrow="Safety first"
          title="Always <em>consultation-led</em>"
          lead="Before any injectable, Chlo reviews your medical history, allergies and skincare so your treatment is suitable, safe and tailored to your goals."
        />
        <ul class="consult__points" role="list" data-reveal-stagger>
          <li><Icon name="shield" size={20} /> Fully licensed &amp; insured</li>
          <li><Icon name="check" size={20} /> Numbing cream for comfort</li>
          <li><Icon name="sparkle" size={20} /> Tailored aftercare advice</li>
        </ul>
      </div>
      <Faq items={boosterFaqs} />
    </div>
  </section>
</Layout>

<style>
  .profhilo__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .profhilo__media {
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--r-xl);
    background: #fff;
    box-shadow: var(--shadow-lg);
  }
  .profhilo__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profhilo__body {
    display: grid;
    gap: 1.5rem;
  }
  .profhilo__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .profhilo__price {
    font-size: var(--step-5);
    line-height: 1;
  }
  .profhilo__highlights {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    margin: 0;
    font-weight: 600;
  }
  .profhilo__highlights li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .profhilo__highlights :global(svg) {
    color: var(--rose-gold-text);
  }
  .profhilo__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .booster-list {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
  }
  .booster {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--paper);
    transition:
      box-shadow 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .booster:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .booster__media {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--blush);
    color: var(--rose-gold);
  }
  .booster__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .booster__body {
    display: grid;
    gap: 0.4rem;
  }
  .booster__time {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .booster__aside {
    display: grid;
    justify-items: end;
    gap: 0.6rem;
  }
  .booster__price {
    font-size: var(--step-3);
    color: var(--rose-gold-text);
  }

  .consult__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .consult__head {
    display: grid;
    gap: 2rem;
  }
  .consult__points {
    display: grid;
    gap: 0.8rem;
    padding: 0;
    margin: 0;
    font-weight: 600;
  }
  .consult__points li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .consult__points :global(svg) {
    color: var(--rose-gold-text);
  }

  @media (max-width: 900px) {
    .profhilo__grid,
    .consult__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .booster {
      grid-template-columns: 84px 1fr;
    }
    .booster__aside {
      grid-column: 1 / -1;
      grid-auto-flow: column;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
