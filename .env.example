# Copy this file to `.env` and fill in your key. `.env` is gitignored and only
# ever read on the server — it is never sent to the browser.

# Groq API key — create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the chat model (defaults to the one in src/lib/chatConfig.ts)
GROQ_MODEL=
